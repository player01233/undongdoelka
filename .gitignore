# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 폴더 (직접 확인 후 지우기 전까지 보관, 커밋 금지)
/trash-can/

# 앱에서 내보낸 백업 파일 (수업 일정이 들어 있어 커밋 금지)
undongdoelka-backup-*.json

# 도구가 만드는 작업 기록·설정 폴더 (공유할 의도 없음, 커밋 금지)
/.bkit/
/.claude/
